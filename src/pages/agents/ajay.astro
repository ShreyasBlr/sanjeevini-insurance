  <section class="section section-height-3 border-0 m-0">
    <div class="container pb-3">
      <div class="row">
        <div class="col text-center">
          <h2
            class="text-color-dark font-weight-medium text-8 mb-5 appear-animation"
            data-appear-animation="fadeInUpShorterPlus"
            data-appear-animation-delay="100"
          >
            Insurance <strong>Products</strong>
          </h2>
        </div>
      </div>
      <div class="row justify-content-center gy-5 mb-5">
        {
          insuranceOptions.map((insurance) => (
            <div
              class="col-9 col-sm-10 col-md-7 col-lg-6 col-xl-3 text-center appear-animation"
              data-appear-animation="fadeInRightShorterPlus"
              data-appear-animation-delay="100"
            >
              <img
                width="90"
                height="90"
                src={insurance.icon}
                alt=""
                class="mb-3 color-primary"
              />
              <h3 class="text-color-dark font-weight-bold text-transform-none text-5 mb-4-5">
                {insurance.name} <br /> Insurance
              </h3>
              <p class="text-3-5">{insurance.description}</p>
              <a
                href={`https://wa.me/918050940914?text=Hi%20Ajay%2C%20I%20am%20interested%20in%20${insurance.name}%20Insurance`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-decoration-none custom-link-hover-effects"
              >
                <button class="btn btn-outline btn-primary">
                  <i class="fab fa-whatsapp" /> Enquire now
                </button>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  const shareForm = document.getElementById("agent-share-form");

  shareForm.addEventListener("submit", function (event) {
    event.preventDefault();
    const name = (shareForm.querySelector("#name-input") as HTMLInputElement)
      .value;
    const number = (shareForm.querySelector("#phone-input") as HTMLInputElement)
      .value;
    const message = `Hi ${name} please reach out to Ajay for all your Insurance needs. View his digital card at ${window.location} You can contact him at +91 805-094-0914.`;
    const whatsappUrl = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, "_blank");
  });
</script>
