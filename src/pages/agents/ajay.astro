---
import Layout from "../../layouts/Layout.astro";

const insuranceOptions = [
  {
    icon: "/img/demos/insurance/icons/life.png",
    name: "Life",
    description:
      "Secure your future with comprehensive Life Insurance. Get peace of mind and financial protection for your loved ones.",
  },
  {
    icon: "/img/demos/insurance/icons/health.png",
    name: "Health",
    description:
      "Protect your family's health with reliable insurance. Enjoy peace of mind knowing you're covered. Your well-being matters.",
  },
  {
    icon: "/img/demos/insurance/icons/business.png",
    name: "Business",
    description:
      "Mitigate risks, ensure growth. Explore business insurance options for comprehensive coverage.",
  },
  {
    icon: "/img/demos/insurance/icons/general.png",
    name: "Motor",
    description:
      "Secure your vehicle against accidents, theft, and natural calamities. Mandatory in India for at least third-party coverage.",
  },
  {
    icon: "/img/demos/insurance/icons/general.png",
    name: "Home",
    description:
      "Insure home against fire, theft, disasters, with liability coverage. Protect your property with comprehensive insurance.",
  },
  {
    icon: "/img/demos/insurance/icons/general.png",
    name: "Travel",
    description:
      "Covers trip mishaps, from cancellations to emergencies. Get protected during domestic or international travel.",
  },
  {
    icon: "/img/demos/insurance/icons/general.png",
    name: "Personal Accident",
    description:
      "Get financial support for accidental death or disablement with personal accident insurance for you and your family.",
  },
  {
    icon: "/img/demos/insurance/icons/general.png",
    name: "Company employee",
    description:
      "Group insurance secures employees' health, life, disability, offering medical coverage, death benefits, and income security.",
  },
];
---

<Layout title="Agents">
  <section class="section bg-transparent position-relative border-0 m-0 p-0">
    <div class="container custom-container-background custom-z-index-1 py-5">
      <div class="pt-5"></div>
      <div class="row pt-4">
        <div class="col-12 col-lg-8 col-xl-6 mb-5-5">
          <div class="card p-2 p-md-3">
            <div class="agent-info-card">
              <div class="agent-img">
                <div
                  class="agent-card-img-container"
                  style="background-image: url('/img/agents/ajay.jpeg');"
                >
                </div>
                <!-- <h6 class="mt-3 mb-0">Connect with agent:</h6>
                <ul
                  class="social-icons social-icons-clean social-icons-icon-dark social-icons-medium mb-0"
                >
                  <li class="social-icons-facebook">
                    <a
                      href="http://www.facebook.com/"
                      target="_blank"
                      title="Facebook"><i class="fab fa-facebook-f"></i></a
                    >
                  </li>
                  <li class="social-icons-twitter">
                    <a
                      href="http://www.twitter.com/"
                      target="_blank"
                      title="Twitter"><i class="fab fa-twitter"></i></a
                    >
                  </li>
                  <li class="social-icons-linkedin">
                    <a
                      href="http://www.linkedin.com/"
                      target="_blank"
                      title="Linkedin"><i class="fab fa-linkedin-in"></i></a
                    >
                  </li>
                </ul> -->
              </div>
              <div class="agent-info">
                <div>
                  <h4
                    class="text-color-secondary font-weight-bold line-height-2 text-6 mt-3 mb-2"
                  >
                    AJAY R
                  </h4>
                  <h3
                    class="d-block text-color-default font-weight-semibold line-height-1 positive-ls-2 text-2 mb-3"
                  >
                    CLAIMS & RENEWALS
                  </h3>
                </div>
                <div class="agent-contact-info">
                  <ul class="list list-unstyled mb-0">
                    <li class="d-flex align-items-center mb-2">
                      <i
                        class="icon icon-envelope text-color-dark font-weight-bold position-relative top-1 me-3-5"
                      ></i>
                      <a
                        href="mailto:ajay@sanjeevniinsurance.in"
                        class="d-inline-flex align-items-center text-decoration-none text-color-dark text-color-hover-primary font-weight-semibold"
                        >ajay@sanjeevniinsurance.in</a
                      >
                    </li>
                    <li class="d-flex align-items-center mb-2">
                      <i
                        class="icon icon-phone text-color-dark font-weight-bold position-relative top-1 me-3-5"
                      ></i>
                      <a
                        href="tel:+918050940914"
                        class="d-inline-flex align-items-center text-decoration-none text-color-dark text-color-hover-primary font-weight-semibold"
                        >+91 805-094-0914</a
                      >
                    </li>
                    <li class="d-flex align-items-center mb-0">
                      <i
                        class="fab fa-whatsapp text-color-dark font-weight-bold position-relative top-1 me-3-5"
                      ></i>
                      <a
                        href="tel:+918050940914"
                        class="d-inline-flex align-items-center text-decoration-none text-color-dark text-color-hover-primary font-weight-semibold"
                        >+91 805-094-0914</a
                      >
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4 col-xl-6 mb-5-5">
          <div class="card p-2 p-md-3">
            <form action="#" id="agent-share-form">
              <div class="agent-share-form-container">
                <h2 class="mb-0">Share agent contact</h2>
                <input
                  class="form-control"
                  type="text"
                  id="name-input"
                  placeholder="Name"
                />
                <input
                  class="form-control"
                  type="text"
                  id="phone-input"
                  placeholder="WhatsApp Number"
                />
                <button type="submit" class="btn btn-primary fs-6">
                  <i class="fab fa-whatsapp" style="font-weight:600;"></i>
                  Share on WhatsApp
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
  <hr />
  <section class="section bg-transparent position-relative border-0 m-0 p-0">
    <div class="container custom-container-background z-index-1 py-5">
      <div class="row position-relative z-index-1 pt-5-5">
        <div class="col text-center">
          <h2 class="text-color-dark font-weight-medium text-8 mb-5-5">
            Why Choose <strong>Sanjeevni Insurance</strong> ?
          </h2>
        </div>
      </div>
      <div class="row justify-content-center position-relative gy-5 z-index-1">
        <div
          class="col-md-9 col-lg-4 text-center appear-animation"
          data-appear-animation="fadeInLeftShorterPlus"
          data-appear-animation-delay="100"
        >
          <img
            width="90"
            height="90"
            src="/img/demos/insurance/icons/rounded-dollar.svg"
            alt=""
            data-icon
            data-plugin-options="{'onlySVG': true, 'extraClass': 'svg-fill-color-secondary mb-4-5'}"
          />
          <h3
            class="text-color-dark text-transform-none text-5-6 font-weight-semibold mb-3"
          >
            Extensive Coverage Options
          </h3>
          <p class="text-3-5 mb-0">
            Explore our range of insurance options, from life policies securing
            your loved ones to health plans covering medical
            expenses—comprehensive protection for every aspect of your life.
          </p>
        </div>
        <div
          class="col-md-9 col-lg-4 text-center appear-animation"
          data-appear-animation="fadeIn"
          data-appear-animation-delay="100"
        >
          <img
            width="90"
            height="90"
            src="/img/demos/insurance/icons/mouse-dollar.svg"
            alt=""
            data-icon
            data-plugin-options="{'onlySVG': true, 'extraClass': 'svg-stroke-color-primary mb-4-5'}"
          />
          <h3
            class="text-color-dark text-transform-none text-5-6 font-weight-semibold mb-3"
          >
            Personalized Service
          </h3>
          <p class="text-3-5 mb-0">
            Sanjeevni Insurance offers personalized support in selecting the
            best plan for your unique needs. Our experienced team ensures you
            get essential coverage without unnecessary costs, fostering trust
            and reliability.
          </p>
        </div>
        <div
          class="col-md-9 col-lg-4 text-center appear-animation"
          data-appear-animation="fadeInRightShorterPlus"
          data-appear-animation-delay="100"
        >
          <img
            width="90"
            height="90"
            src="/img/demos/insurance/icons/money-suitcase.svg"
            alt=""
            data-icon
            data-plugin-options="{'onlySVG': true, 'extraClass': 'svg-stroke-color-secondary mb-4-5'}"
          />
          <h3
            class="text-color-dark text-transform-none text-5-6 font-weight-semibold mb-3"
          >
            Hassle-Free Claims Process
          </h3>
          <p class="text-3-5 mb-0">
            Sanjeevni Insurance prioritizes a smooth claims process for quick
            and efficient settlements. Our dedicated team supports you at every
            step, minimizing stress during unfortunate events.
          </p>
        </div>
      </div>
      <div class="row py-5">
        <div class="col">
          <hr />
        </div>
      </div>
      <div class="row align-items-center pb-5 pb-lg-0 mb-5 mb-lg-0">
        <div
          class="col-lg-5 text-center text-lg-start appear-animation"
          data-appear-animation="fadeInRightShorterPlus"
          data-appear-animation-delay="100"
        >
          <img
            src="/img/_home/square_2.jpg"
            class="img-fluid rounded-circle mb-4 mb-lg-0"
            alt=""
          />
        </div>
        <div
          class="col-lg-6 text-center text-lg-start appear-animation"
          data-appear-animation="fadeInRightShorterPlus"
          data-appear-animation-delay="100"
        >
          <h2 class="text-color-dark font-weight-medium text-8 mb-4-5">
            Insurance With <strong>Incredible Rates</strong>
          </h2>
          <p class="text-3-5 line-height-8 mb-4">
            Sanjeevni Insurance ensures affordable quality coverage, offering
            competitive pricing options. Our dedication to protecting your
            assets and loved ones means finding cost-effective insurance
            solutions that fit your budget.
          </p>
          <a
            href="#"
            class="btn btn-secondary btn-outline btn-rounded font-weight-bold btn-px-5 py-3"
            >VIEW INSURANCES</a
          >
        </div>
      </div>
      <div class="row align-items-center pt-1 my-5">
        <div
          class="col-lg-6 text-center text-lg-start order-2 order-lg-1 appear-animation"
          data-appear-animation="fadeInLeftShorterPlus"
          data-appear-animation-delay="100"
        >
          <h2 class="text-color-dark font-weight-medium text-8 mb-4-5">
            Trust and <strong>Reliability</strong>
          </h2>
          <p class="text-3-5 line-height-8 mb-4">
            Count on our reliability. We're known for professionalism,
            integrity, and exceptional customer service, ensuring the protection
            you need and the peace of mind you deserve.
          </p>
          <a
            href="#"
            class="btn btn-secondary btn-outline btn-rounded font-weight-bold btn-px-5 py-3"
            >GET A QUOTE</a
          >
        </div>
        <div class="col-lg-5 text-center text-lg-end order-1 order-lg-2">
          <img
            src="/img/_home/trust_realiability.jpg"
            class="img-fluid rounded-circle mb-4 mb-lg-0 appear-animation"
            data-appear-animation="fadeInLeftShorterPlus"
            data-appear-animation-delay="100"
            alt=""
          />
        </div>
      </div>
    </div>
